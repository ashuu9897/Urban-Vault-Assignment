# Copy to .env for local development. Never commit a real .env file.
DEBUG=true
# Required when DEBUG=false. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TIME_ZONE=Asia/Kolkata
# Optional. Defaults to SQLite (backend/db.sqlite3). Example for PostgreSQL:
# DATABASE_URL=postgres://helpdesk:helpdesk@localhost:5432/helpdesk
